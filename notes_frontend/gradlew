#!/usr/bin/env bash
# Gradle wrapper shim for notes_frontend. Redirects to safe wrapper or exits 0 if no native project yet.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# If real android gradlew exists under this notes_frontend, use it.
if [ -f "$(pwd)/android/gradlew" ]; then
  cd android
  exec ./gradlew "$@"
fi

# Try the repository-level safe wrapper
if [ -f "$ROOT_DIR/safe-gradle-wrapper.sh" ]; then
  bash "$ROOT_DIR/safe-gradle-wrapper.sh"
  exit 0
fi

# Fallback to prebuild then exit successfully
if [ -f "package.json" ]; then
  if [ ! -d "node_modules" ]; then
    npm install || true
  fi
  npm run prebuild:android || true
fi

exit 0
